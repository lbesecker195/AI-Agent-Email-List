# Copy to .env and fill in. Every mix command reads it, so credentials are set
# once per machine rather than retyped on each command. .env is gitignored.
#
#   cp .env.example .env
#
# A real environment variable always beats this file, so
# `DATABASE_URL=... mix test` still overrides what is here.

# --- Database ---------------------------------------------------------------
# DATABASE_URL is the one setting that works everywhere. Set it and you can
# ignore the PG* variables entirely.
DATABASE_URL=ecto://mailer:changeme@localhost/email_provider_dev

# Or, instead of DATABASE_URL, the standard libpq variables:
# PGUSER=mailer
# PGPASSWORD=changeme
# PGHOST=localhost
# PGPORT=5432
#
# PGDATABASE is deliberately not read. The database name is which application's
# data this is, not a credential, and that variable is often already exported
# on a shared machine for something else. Name the database in DATABASE_URL.

# Connections to open. Small on a shared Postgres: one that hits
# max_connections refuses every client, including services already connected.
POOL_SIZE=5

# --- Web --------------------------------------------------------------------
# 4000 through 4003 are usually taken on these machines.
PORT=4005

# Required in production only. Generate with: mix phx.gen.secret
# SECRET_KEY_BASE=

# The hostname this is reachable at, used to build URLs in production.
# PHX_HOST=mail.example.com

# --- Sending ----------------------------------------------------------------
# Without SMTP_RELAY nothing leaves the machine: mail is written to
# priv/local_mail instead. That is the default on purpose.
# SMTP_RELAY=smtp.provider.example
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# What customers are told to publish in their own DNS.
# SPF_HOST=mail.example.com
# MX_HOST=mx.example.com

# --- Content screening ------------------------------------------------------
# OpenAI's moderation endpoint is free to call. Without a key, screening is
# skipped and messages are recorded as unscreened rather than as clean.
# OPENAI_API_KEY=
# MODERATION_ON_ERROR=allow

# --- Account profiles -------------------------------------------------------
# CSUITEFINDER_API_KEY=
# PROFILE_MIN_INTERVAL_SECONDS is 0 by default, meaning one rewrite, and with
# the model generator one model call, per message. Raise it to coalesce.
# PROFILE_MIN_INTERVAL_SECONDS=0
# PROFILES_ENABLED=true
