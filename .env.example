# Copy to .env and fill in. Every mix command reads it, so credentials are set
# once per machine rather than retyped on each command. .env is gitignored.
#
#   cp .env.example .env
#
# A real environment variable always beats this file, so
# `DATABASE_URL=... mix test` still overrides what is here.

# --- Database ---------------------------------------------------------------
# DATABASE_URL is the one setting that works everywhere. Set it and you can
# ignore the PG* variables entirely.
DATABASE_URL=ecto://mailer:changeme@localhost/email_provider_dev

# Or, instead of DATABASE_URL, the standard libpq variables:
# PGUSER=mailer
# PGPASSWORD=changeme
# PGHOST=localhost
# PGPORT=5432
#
# PGDATABASE is deliberately not read. The database name is which application's
# data this is, not a credential, and that variable is often already exported
# on a shared machine for something else. Name the database in DATABASE_URL.

# Connections to open. Small on a shared Postgres: one that hits
# max_connections refuses every client, including services already connected.
POOL_SIZE=5

# --- Web --------------------------------------------------------------------
# 4000 through 4003 are usually taken on these machines.
PORT=4005

# Required in production only. Generate with: mix phx.gen.secret
# SECRET_KEY_BASE=

# The hostname this is reachable at, used to build URLs in production.
PHX_HOST=ai.agentemaillist.com

# --- Sending ----------------------------------------------------------------
# Three ways out, in this order of precedence. With none of them set nothing
# leaves the machine: mail is written to priv/local_mail. That is the default
# on purpose.
#
# 1. A smarthost, if you have one. Best deliverability for the least work.
# SMTP_RELAY=smtp.provider.example
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
#
# 2. Direct delivery to each recipient's MX, with no smarthost. This is what
#    makes the service a provider rather than a client of one.
#
#    Vultr blocks outbound port 25 on new accounts. Until you open a support
#    ticket asking them to unblock it, every direct delivery times out.
# DIRECT_DELIVERY=true
# DIRECT_SMTP_PORT=25

# What customers are told to publish in their own DNS, and the name this server
# gives in its own HELO. Receiving servers check that it resolves, and compare
# it against the reverse DNS of the connecting address, so set the PTR for
# 155.138.220.76 to match in the Vultr panel.
SMTP_HOSTNAME=ai.agentemaillist.com
SPF_HOST=ai.agentemaillist.com
MX_HOST=ai.agentemaillist.com

# --- Receiving --------------------------------------------------------------
# Port 25 needs root or CAP_NET_BIND_SERVICE. A listener that cannot bind is
# logged and skipped rather than taking the application down.
# SMTP_RECEIVE_ENABLED=true
# SMTP_RECEIVE_PORT=25

# Submission, where a customer's own mail software authenticates with the
# credentials issued when their domain was added, then sends through us.
# Never put this on port 25.
# SMTP_SUBMISSION_ENABLED=true
# SMTP_SUBMISSION_PORT=587

# Acceptor pool and connection ceiling per listener.
# SMTP_ACCEPTORS=10
# SMTP_MAX_CONNECTIONS=200

# --- Delivery queue ---------------------------------------------------------
# Delivery is almost all waiting on the network, so it runs concurrently. Keep
# DELIVERY_CONCURRENCY under POOL_SIZE: each in-flight delivery holds a
# database connection.
# DELIVERY_CONCURRENCY=10
# DELIVERY_BATCH_SIZE=200
# DELIVERY_INTERVAL_MS=5000

# --- Content screening ------------------------------------------------------
# OpenAI's moderation endpoint is free to call. Without a key, screening is
# skipped and messages are recorded as unscreened rather than as clean.
# OPENAI_API_KEY=
# MODERATION_ON_ERROR=allow

# --- Account profiles -------------------------------------------------------
# CSUITEFINDER_API_KEY=
# PROFILE_MIN_INTERVAL_SECONDS is 0 by default, meaning one rewrite, and with
# the model generator one model call, per message. Raise it to coalesce.
# PROFILE_MIN_INTERVAL_SECONDS=0
# PROFILES_ENABLED=true
