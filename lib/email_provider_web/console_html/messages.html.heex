<.layout title="Messages" flash={@flash} current_user={@current_user} active={:messages}>
  <h1>Messages</h1>
  <p class="lede">The last {length(@messages)} messages across your domains.</p>

  <div :if={@messages == []} class="card">
    <p style="margin:0">Nothing yet. <a href="/send">Send one</a>.</p>
  </div>

  <div :if={@messages != []} class="scroll">
    <table>
      <tr>
        <th>When</th>
        <th>Direction</th>
        <th>Correspondent</th>
        <th>Subject</th>
        <th>Status</th>
      </tr>
      <tr :for={message <- @messages}>
        <td class="hint">
          <a href={"/messages/#{message.id}"}>
            {Calendar.strftime(message.inserted_at, "%d %b %H:%M")}
          </a>
        </td>
        <td>{message.direction}</td>
        <td class="mono">
          {if message.direction == "outbound",
            do: Enum.join(message.recipients, ", "),
            else: message.sender}
        </td>
        <td>
          <a href={"/messages/#{message.id}"}>{message.subject}</a>
        </td>
        <td>
          {message.status}<span :if={message.test_mode} class="hint"> (test)</span><span
            :if={message.folder == "spam"}
            class="hint"
          > spam</span>
        </td>
      </tr>
    </table>
  </div>
</.layout>
