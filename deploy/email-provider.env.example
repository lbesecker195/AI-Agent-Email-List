# Production environment for the systemd unit.
#
#   sudo cp deploy/email-provider.env.example /etc/email-provider.env
#   sudo chown root:mailer /etc/email-provider.env
#   sudo chmod 640 /etc/email-provider.env
#   sudo nano /etc/email-provider.env
#
# This is not the project's .env. That one is for mix commands in development;
# this one is read by systemd and is the only place production secrets live.
# Both are deliberately outside git.
#
# Note the format: systemd EnvironmentFile, so no `export`, no shell expansion,
# and quotes are taken literally. Write PASSWORD=hunter2, not PASSWORD="hunter2".

MIX_ENV=prod
PHX_SERVER=true

# --- Required. The release refuses to boot without these. -------------------

# mix phx.gen.secret
SECRET_KEY_BASE=replace-me

# Opens /admin, which shows figures spanning every account. With none set the
# dashboard refuses to open at all, which is the right failure mode for a
# missing variable. Generate with: openssl rand -hex 24
ADMIN_TOKEN=replace-me

DATABASE_URL=ecto://mailer:replace-me@localhost/email_provider_prod

PHX_HOST=ai.agentemaillist.com

# --- Web --------------------------------------------------------------------

PORT=4005

# Loopback, because nginx is in front. Set 0.0.0.0 only if you are deliberately
# exposing the application port with no proxy.
BIND_IP=127.0.0.1

# There is no FORCE_SSL setting. Phoenix reads :force_ssl at compile time, so a
# release refuses to boot if a runtime value disagrees with the one built in.
# HTTPS enforcement and HSTS live in config/prod.exs and are always on; they
# exclude loopback so health checks still answer.

# Keep under the Postgres max_connections this machine has left; csuite_finder
# is using some of it.
POOL_SIZE=10

# --- Sending ----------------------------------------------------------------

# Outbound port 25 is blocked on new Vultr accounts. Until a support ticket
# lifts that, leave this off: every delivery would simply time out. With both
# this and SMTP_RELAY unset, mail is written to disk and nothing is sent.
# DIRECT_DELIVERY=true

# Or relay through a smarthost, which needs no port 25 and delivers better from
# a new IP address.
# SMTP_RELAY=smtp.provider.example
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

SMTP_HOSTNAME=ai.agentemaillist.com
SPF_HOST=ai.agentemaillist.com
MX_HOST=ai.agentemaillist.com

# --- Receiving --------------------------------------------------------------
# The unit grants CAP_NET_BIND_SERVICE, so these work as an unprivileged user.
# Turn them on once the MX record exists, not before.
# SMTP_RECEIVE_ENABLED=true
# SMTP_SUBMISSION_ENABLED=true

# --- Optional ---------------------------------------------------------------

# Content screening. Without a key, messages are recorded as unscreened rather
# than as clean, and nothing is blocked.
# OPENAI_API_KEY=

# Account profiles.
# CSUITEFINDER_API_KEY=
# PROFILE_MIN_INTERVAL_SECONDS=0
